# Copy to .env and fill in. Real environment variables override these.

# Google Custom Search (image search fallback)
# API key: https://developers.google.com/custom-search/v1/overview
# CX (Search Engine ID): https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CX=

# Ollama via the Colab notebook's ngrok tunnel — host only, no https://, no trailing slash
OLLAMA_HOST=your-tunnel.ngrok-free.dev
OLLAMA_MODEL=qwen3:14b
# Smaller model for cheap extraction tasks (e.g. qwen2.5:3b); defaults to OLLAMA_MODEL
OLLAMA_FAST_MODEL=
OLLAMA_KEEP_ALIVE=30m

# Python interpreter with chromadb installed (used by kb.js to run query_kb.py)
PYTHON_PATH=python

PORT=3000
